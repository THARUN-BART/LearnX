# LearnX Backend Environment Configuration Template

# 1. External OTP Service Configuration
OTP_SERVICE_BASE_URL=https://otp-latest-0k73.onrender.com
OTP_APP_NAME=LearnX
OTP_TIMEOUT_SECONDS=15
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# 2. Supabase Auth & PostgreSQL Credentials
# NOTE: SUPABASE_SERVICE_ROLE_KEY must remain strictly backend-only. Never expose to client applications!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_DB_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 3. Server Configuration
SERVER_PORT=8080
SERVER_ENV=development
CLIENT_URL=http://localhost:3000

# 4. Pending Credentials & Token Security
# 32-byte key or secret used for AES-256-GCM encryption of pending signup credentials
ENCRYPTION_KEY=learnx-32-byte-secret-encryption-key-for-pending-passwords
SIGNUP_EXPIRY_MINUTES=10
RESET_TOKEN_EXPIRY_MINUTES=15

# 5. Code Execution Sandbox & Worker Configuration
# Execution provider:
# - 'judge0' for live sandbox execution
# - 'wandbox' for free cloud multi-compiler execution (no setup, zero auth)
# - 'local' for native compiler runner (gcc, g++, python3, go, java)
# - 'mock' for local offline testing
EXECUTION_PROVIDER=local
EXECUTION_TIMEOUT_SECONDS=15
SUBMISSION_WORKER_CONCURRENCY=4
SUBMISSION_QUEUE_SIZE=1000

# Judge0 settings (required only when EXECUTION_PROVIDER=judge0)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# 6. AI Tutor & Mistake Detection Engine (Gemini / OpenAI / Mock)
# Provider options:
# - 'gemini' (recommended): queries Google Gemini REST API (requires GEMINI_API_KEY)
# - 'openai': queries OpenAI /v1/chat/completions (requires OPENAI_API_KEY)
# - 'mock': offline simulated responses (runs without network or API charges)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# 7. Pedagogy Microservice (Diagnostic & Scaffolding Engine)
PEDAGOGY_SERVICE_URL=http://localhost:8001
PEDAGOGY_TIMEOUT_SECONDS=10
