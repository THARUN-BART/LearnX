# LearnX Backend Authentication Environment Configuration

# External OTP Service Configuration
OTP_SERVICE_BASE_URL=https://otp-latest-0k73.onrender.com
OTP_APP_NAME=LearnX
OTP_TIMEOUT_SECONDS=15
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Supabase Auth & PostgreSQL Credentials
# NOTE: SUPABASE_SERVICE_ROLE_KEY must remain strictly backend-only. Never expose to client applications!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_DB_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development
CLIENT_URL=http://localhost:3000

# Pending Credentials & Token Security
# 32-byte key or secret used for AES-256-GCM encryption of pending signup credentials
ENCRYPTION_KEY=learnx-super-secret-encryption-key-for-pending-passwords
SIGNUP_EXPIRY_MINUTES=10
RESET_TOKEN_EXPIRY_MINUTES=15
